# 复制本文件为 .env 后填入真实值；.env 已被 .gitignore 排除，不会提交到仓库

# MySQL 连接串：密码里的特殊字符要 URL 编码（@ -> %40），驱动用 aiomysql
DATABASE_URL=mysql+aiomysql://<user>:<password_url_encoded>@localhost:3306/db001?charset=utf8mb4

# Redis（redis-py 客户端，密码写明文原值即可，不用 URL 编码）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<your_redis_password>

# JWT
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=<openssl rand -hex 16 生成>

# Celery（RabbitMQ broker + Redis result backend；密码同样要 URL 编码）
BROKER=amqp://<user>:<password>@localhost:5672//
BACKEND=redis://:<password_url_encoded>@localhost:6379/2

# QQ 邮箱 SMTP（SMTP_PASS 是授权码，不是登录密码）
SMTP_USER=your_mail@qq.com
SMTP_PORT=465
SMTP_HOST=smtp.qq.com
SMTP_PASS=<your_smtp_auth_code>

# 时区
CELERY_TIMEZONE=Asia/Shanghai
